# === 이 파일을 .env 로 복사해서 사용하세요. .env 는 커밋 금지 ===
# DB·비밀·키는 전부 여기(.env)에. 코드에 하드코딩 금지.

# --- 데이터베이스 (로컬은 docker-compose 기본값) ---
DATABASE_URL="postgresql://aihub:aihub_dev_pw@localhost:5432/aihub?schema=public"
# 운영(EC2, docker-compose.prod.yml)에서는 호스트를 postgres 로, 비밀번호는 아래 POSTGRES_PASSWORD 와 동일하게:
# DATABASE_URL="postgresql://aihub:<POSTGRES_PASSWORD>@postgres:5432/aihub?schema=public"
# POSTGRES_USER="aihub"
# POSTGRES_PASSWORD="change-me-strong-password"
# POSTGRES_DB="aihub"

# --- 임직원 인증 (현재: @hanwha.com 도메인 검증 / 추후 Azure AD SSO) ---
# Auth.js 세션 서명 키
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
# 허용 도메인 (이 도메인으로 끝나는 이메일만 로그인 가능)
ALLOWED_EMAIL_DOMAIN="hanwha.com"
# 임시 로그인 비밀번호(임직원 공용). SSO 도입 시 제거.
EMPLOYEE_DEV_PASSWORD="change-me"
# (추후 SSO 교체 시) Azure AD / Microsoft Entra ID
# AZURE_AD_CLIENT_ID=""
# AZURE_AD_CLIENT_SECRET=""
# AZURE_AD_TENANT_ID=""

# --- 관리자 인증 (임직원 인증과 분리, 임시) ---
ADMIN_ID="admin"
ADMIN_PW="admin"
ADMIN_SECRET="change-me-separate-admin-session-secret"

# --- LLM (백엔드 경유만. 프런트에 노출 금지) ---
# 에이전트 "만들기"(AI 초안 생성)에만 사용. 에이전트 "실행"은
# claude.ai 딥링크로 각자 PC에서 직접 수행하므로 백엔드 LLM 비용이 들지 않음.
ANTHROPIC_API_KEY=""

# --- 배포 ---
# HTTPS 없이 IP(HTTP)로 운영할 때만 false. 도메인·HTTPS 적용 후에는 지우거나 true.
# COOKIE_SECURE="false"

# --- 개발 편의 ---
NODE_ENV="development"
